# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Public URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anonymous key — safe to expose; permissions enforced by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — NEVER expose to the browser or prefix with NEXT_PUBLIC_
# Used exclusively in server-side code (Server Actions, Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── LocationIQ ─────────────────────────────────────────────────────────────────
# Provider de geocoding, autocomplete de endereço e tiles de mapa. O DataForSEO
# não tem produto para nenhum dos três, e é por isso que ele existe aqui.
# Plano gratuito: 5.000 requisições/dia, uso comercial permitido.
#
# São DOIS tokens, e os dois são "Data API token" no painel — o que muda entre
# eles são as PERMISSÕES marcadas e a restrição por referrer. A separação existe
# porque um vai ao navegador e o outro não:
#   - LOCATIONIQ_API_KEY: só GEOCODING marcado, sem referrer. Nunca sai daqui.
#   - NEXT_PUBLIC_LOCATIONIQ_MAPS_KEY: só Vector e Raster Map Tiles marcados, e
#     HTTP Referrers preenchido. Fica visível no HTML — restrito por referrer e
#     sem geocoding, não serve para mais nada se for copiado.
LOCATIONIQ_API_KEY=<your-locationiq-api-token>
NEXT_PUBLIC_LOCATIONIQ_MAPS_KEY=<your-locationiq-maps-access-token>

# ── DataForSEO ─────────────────────────────────────────────────────────────────
# Server-only. Provider único de todas as coletas da auditoria: perfil do
# Google, avaliações, posts, Q&A, ranking no Maps, malha geográfica e
# visibilidade orgânica. Saldo, uso e preços aparecem em Configurações →
# Ferramentas, lidos de /v3/appendix/user_data.
# Do not prefix with NEXT_PUBLIC_.
DATAFORSEO_LOGIN=<your-dataforseo-login>
DATAFORSEO_PASSWORD=<your-dataforseo-password>

# ── Client portal (briefing) ───────────────────────────────────────────────────
# Server-only pepper used to hash access codes and sign the portal cookie.
# Do not prefix with NEXT_PUBLIC_. Generate a long random string.
CLIENT_PORTAL_PEPPER=<random-secret>

# Server-only key used to encrypt briefing access passwords (AES-256-GCM).
# Prefer 32 raw bytes as base64, or 64 hex chars; any long string is SHA-256-derived.
# Do not prefix with NEXT_PUBLIC_.
BRIEFING_SECRETS_KEY=<random-secret>

# Public origin used when copying the client briefing link.
# Example: https://suite.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth pre-requisites ────────────────────────────────────────────────────────
# For immediate account activation without email confirmation:
# Supabase Dashboard → Authentication → Email → "Confirm email" → OFF
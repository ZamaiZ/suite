# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Public URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anonymous key — safe to expose; permissions enforced by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — NEVER expose to the browser or prefix with NEXT_PUBLIC_
# Used exclusively in server-side code (Server Actions, Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Google Places (New) ────────────────────────────────────────────────────────
# Server-only. Enable Places API (New) on the Google Cloud project.
# Do not prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=<your-places-api-key>

# ── DataForSEO (GBP Info) ──────────────────────────────────────────────────────
# Server-only. Used by "Analisar perfil" on opportunity GBP cards.
# Do not prefix with NEXT_PUBLIC_.
DATAFORSEO_LOGIN=<your-dataforseo-login>
DATAFORSEO_PASSWORD=<your-dataforseo-password>

# ── SerpAPI (GBP alternative) ──────────────────────────────────────────────────
# Server-only. Alternative to DataForSEO for opportunity GBP analysis.
# Do not prefix with NEXT_PUBLIC_.
SERPAPI_API_KEY=<your-serpapi-api-key>

# ── PageSpeed Insights ─────────────────────────────────────────────────────────
# Server-only. Used by website audit after the HTML crawl (mobile + desktop).
# Enable PageSpeed Insights API on the Google Cloud project.
# Falls back to GOOGLE_PLACES_API_KEY when unset.
# Do not prefix with NEXT_PUBLIC_.
PAGESPEED_API_KEY=<your-pagespeed-api-key>

# ── Client portal (briefing) ───────────────────────────────────────────────────
# Server-only pepper used to hash access codes and sign the portal cookie.
# Do not prefix with NEXT_PUBLIC_. Generate a long random string.
CLIENT_PORTAL_PEPPER=<random-secret>

# Server-only key used to encrypt briefing access passwords (AES-256-GCM).
# Prefer 32 raw bytes as base64, or 64 hex chars; any long string is SHA-256-derived.
# Do not prefix with NEXT_PUBLIC_.
BRIEFING_SECRETS_KEY=<random-secret>

# Public origin used when copying the client briefing link.
# Example: https://suite.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Maps JavaScript (briefing radius map) ───────────────────────────────
# Public browser key — restrict by HTTP referrer in Google Cloud Console.
# Enable only Maps JavaScript API on this key. Do not reuse GOOGLE_PLACES_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-public-api-key>

# ── Auth pre-requisites ────────────────────────────────────────────────────────
# For immediate account activation without email confirmation:
# Supabase Dashboard → Authentication → Email → "Confirm email" → OFF